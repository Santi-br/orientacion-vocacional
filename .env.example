# Copiar a .env.local. Ninguna de estas variables llega al navegador.

# IA — Groq, plan GRATIS: crear una clave en console.groq.com
# y activar Zero Data Retention en Settings → Data Controls.
# Sin clave, la app funciona completa con reglas, sin IA.
AI_API_KEY=
# Opcionales (valores por defecto para Groq; ver docs/AI_ARCHITECTURE.md):
# AI_PROVIDER=groq
# AI_MODEL_REASONING=openai/gpt-oss-120b
# AI_MODEL_FAST=openai/gpt-oss-20b
# AI_MODEL_PLANNER=qwen/qwen3.8-27b
# AI_EFFORT_REASONING=medium
# AI_EFFORT_FAST=low

# Supabase (hito 8: cuentas y guardado). Plan gratis. La app usa solo la anon key + RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
