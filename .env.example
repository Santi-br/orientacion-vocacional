# Copiar a .env.local. Ninguna de estas variables llega al navegador.

# IA (OpenAI). Sin clave, la app funciona completa con reglas, sin IA.
OPENAI_API_KEY=
# Opcionales: modelos y esfuerzo de razonamiento (ver docs/AI_ARCHITECTURE.md).
# OPENAI_MODEL_REASONING=gpt-6.1-sol
# OPENAI_MODEL_FAST=gpt-6-luna
# OPENAI_EFFORT_REASONING=medium
# OPENAI_EFFORT_FAST=low

# Supabase (hito 8: cuentas y guardado). La app usa solo la anon key + RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
